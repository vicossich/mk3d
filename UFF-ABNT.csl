<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0">
  <info>
    <title>UFF – ABNT adaptado</title>
    <id>http://www.example.com/csl/uff-abnt</id>
    <author>
      <name>Adaptado por Você</name>
    </author>
    <category citation-format="numeric"/>
    <updated>2025-06-22T12:00:00+00:00</updated>
  </info>

  <macro name="author">
    <names variable="author">
      <name form="all" name-as-sort-order="all"/>
      <label form="verb-short" prefix=". "/>
      <substitute>
        <names variable="translator"/>
      </substitute>
    </names>
  </macro>

  <macro name="title">
    <text variable="title" font-style="italic"/>
  </macro>

  <macro name="container-title">
    <text variable="container-title" font-style="italic"/>
  </macro>

  <macro name="issued">
    <date variable="issued">
      <date-part name="day"/>
      <text value=" "/>
      <date-part name="month"/>
      <text value=" "/>
      <date-part name="year"/>
    </date>
  </macro>

  <citation>
    <layout delimiter="; ">
      <text macro="author"/>
      <text variable="year" prefix="(" suffix=")"/>
    </layout>
  </citation>

  <bibliography>
    <layout hanging-indent="true" line-spacing="1">
      <text macro="author" suffix=". "/>
      <text macro="title" suffix=". "/>

      <choose>
        <if type="book">
          <text variable="edition" prefix="" suffix=". "/>
          <text variable="publisher-place" suffix=": "/>
          <text variable="publisher" suffix=", "/>
          <text macro="issued" suffix=". "/>
        </if>
        <else-if type="chapter">
          <text variable="chapter-title" suffix=". "/>
          <text term="in" text-case="capitalize-first" suffix=" "/>
          <text macro="author" variable="editor" suffix=" (ed.). "/>
          <text macro="container-title" suffix=". "/>
          <text variable="volume" prefix="v. " suffix=". "/>
          <text macro="issued" suffix=". p. "/>
          <text variable="page-first" prefix="" suffix="‑"/>
          <text variable="page-last" suffix=". "/>
        </else-if>
        <else-if type="article-journal">
          <text macro="container-title" suffix=", "/>
          <text variable="volume" prefix="v. " suffix=""/>
          <text variable="issue" prefix=", n. " suffix=". "/>
          <text macro="issued" suffix=". p. "/>
          <text variable="page-first" prefix="" suffix="‑"/>
          <text variable="page-last" suffix=". "/>
        </else-if>
        <else-if type="paper-conference">
          <text term="in" text-case="uppercase" suffix=" "/>
          <text variable="event" form="text" suffix=" "/>
          <text macro="issued" suffix=". "/>
          <text macro="container-title" suffix=". "/>
          <text variable="publisher-place" suffix=": "/>
          <text variable="publisher" suffix=", "/>
          <text macro="issued" variable="issued" suffix=". p. "/>
          <text variable="page-first" prefix="" suffix="‑"/>
          <text variable="page-last" suffix=". "/>
        </else-if>
        <else-if type="legislation">
          <text variable="title" font-style="italic" suffix=" – "/>
          <text macro="issued" suffix=". "/>
        </else-if>
        <else-if type="webpage">
          <text variable="container-title" prefix="In: " suffix=". "/>
          <text term="available-from" text-case="lowercase" suffix=": "/>
          <text variable="URL" suffix=". "/>
          <text term="accessed" text-case="lowercase" suffix=": "/>
          <text macro="issued" suffix=". "/>
        </else-if>
        <else-if type="motion_picture">
          <text variable="publisher" suffix=". "/>
          <text term="director" suffix=" "/>
          <text variable="director" suffix=". "/>
          <text macro="issued" suffix=". "/>
        </else-if>
        <else>
          <text macro="issued" suffix=". "/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
